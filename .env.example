# Gemini API Key for hosted demo fallback
# Set this in AI Studio Settings -> Environment Variables
GEMINI_API_KEY=

# Snowflake Cortex REST (MLH Best Use of Snowflake API)
# Account identifier is the host prefix: https://<SNOWFLAKE_ACCOUNT>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_CORTEX_MODEL=llama3.1-70b

# Optional: RapidAPI Key for LinkedIn Jobs REST API (e.g. JSearch or Fantastic Jobs API)
RAPIDAPI_KEY=
